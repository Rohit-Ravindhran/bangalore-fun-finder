8:["$","h2",null,{"className":"text-xl font-bold text-gray-900 mb-4 flex items-center gap-2","children":[["$","span",null,{"className":"bg-orange-500 text-white text-sm font-bold px-2.5 py-0.5 rounded-full","children":"SAT"}],"Saturday, 4 April"]}]
9:["$","div",null,{"className":"space-y-6 mb-10","children":[["$","div",null,{"className":"border-l-2 border-orange-200 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold text-orange-500 uppercase tracking-wide mb-0.5","children":"Morning · Outdoor"}],["$","h3",null,{"className":"font-semibold text-gray-900 mb-1","children":"Cubbon Park to CBD Run"}],["$","p",null,{"className":"text-sm text-gray-500 mb-1","children":"Ambedkar Veedhi, Bengaluru"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":"Start your Saturday the right way. This popular community run goes from Cubbon Park through the CBD and is one of the best ways to see central Bangalore before the city wakes up. Runners of all paces welcome — from serious half-marathon trainers to people who just want a reason to get out of bed early. Bring water. The stretch through Kasturba Road and Raj Bhavan Road under the canopy is genuinely beautiful."}]]}],["$","div",null,{"className":"border-l-2 border-purple-200 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold text-purple-500 uppercase tracking-wide mb-0.5","children":"Afternoon · Workshop"}],["$","h3",null,{"className":"font-semibold text-gray-900 mb-1","children":"Weekend Art & Craft Workshops"}],["$","p",null,{"className":"text-sm text-gray-500 mb-1","children":"Multiple venues, Indiranagar & Koramangala"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":"Saturday afternoons in Bangalore have quietly become prime time for workshops — pottery, painting, macramé, and candle-making sessions fill up most weekends. Check the Happ'nin listings for what's open today. Most run 2–4 hours, all materials included, and beginner-friendly. Good option if you want something productive before the evening kicks in."}]]}],["$","div",null,{"className":"border-l-2 border-pink-200 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold text-pink-500 uppercase tracking-wide mb-0.5","children":"Evening · Music"}],["$","h3",null,{"className":"font-semibold text-gray-900 mb-1","children":"The Eternal Pulse — Live Percussion & Music"}],["$","p",null,{"className":"text-sm text-gray-500 mb-1","children":"The Humming Tree, Indiranagar"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":"The Humming Tree has one of the best live music setups in the city — good sound, intimate space, serious crowd. This performance leans into rhythm and percussion with an ensemble that blends Indian classical elements with contemporary arrangements. Doors usually open at 7 PM; show starts 8–8:30 PM. Book tickets in advance — this venue sells out."}]]}],["$","div",null,{"className":"border-l-2 border-indigo-200 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold text-indigo-500 uppercase tracking-wide mb-0.5","children":"Night · Party"}],["$","h3",null,{"className":"font-semibold text-gray-900 mb-1","children":"Saturday Biggest Bollywood Ladies Night"}],["$","p",null,{"className":"text-sm text-gray-500 mb-1","children":"LUX Pub & Kitchen, Koramangala"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":"Every Saturday at LUX, Koramangala. Bollywood, Punjabi, and commercial hits all night. Starts late — 9 PM onwards — and runs past midnight. This is one of the more consistently good Bollywood nights in the city. Cover charges may apply; check the event listing for the latest entry details."}]]}]]}]
a:["$","h2",null,{"className":"text-xl font-bold text-gray-900 mb-4 flex items-center gap-2","children":[["$","span",null,{"className":"bg-gray-800 text-white text-sm font-bold px-2.5 py-0.5 rounded-full","children":"SUN"}],"Sunday, 5 April"]}]
b:["$","div",null,{"className":"space-y-6 mb-10","children":[["$","div",null,{"className":"border-l-2 border-green-200 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold text-green-600 uppercase tracking-wide mb-0.5","children":"Morning · Outdoor"}],["$","h3",null,{"className":"font-semibold text-gray-900 mb-1","children":"Sunday Trek — Nearby Hills & Trails"}],["$","p",null,{"className":"text-sm text-gray-500 mb-1","children":"Nandi Hills / Savandurga / Ramanagara"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":"Sunday is the classic day for a Bangalore day-trek. Nandi Hills (60 km, 1.5 hrs) is the easiest if you want sunrise views and a leisurely morning. Savandurga (55 km) is better if you want a real climb — it's one of the largest monolith rocks in Asia and the trail is genuinely challenging. Ramanagara (60 km) is famous as the filming location for Sholay and has great bouldering. Leave by 5:30–6 AM to avoid the heat."}]]}],["$","div",null,{"className":"border-l-2 border-amber-200 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-600 uppercase tracking-wide mb-0.5","children":"Morning · Food"}],["$","h3",null,{"className":"font-semibold text-gray-900 mb-1","children":"Sunday Breakfast — CTR or MTR"}],["$","p",null,{"className":"text-sm text-gray-500 mb-1","children":"Malleswaram"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":"If you're not trekking, Sunday morning in Malleswaram is a ritual. Central Tiffin Room (CTR) opens at 7:30 AM and the benne masala dosa queue starts forming before that. MTR at Lalbagh Road is the other institution — rava idli was literally invented there. Get there before 9 AM or expect a 40-minute wait."}]]}],["$","div",null,{"className":"border-l-2 border-orange-200 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold text-orange-500 uppercase tracking-wide mb-0.5","children":"Afternoon · Market"}],["$","h3",null,{"className":"font-semibold text-gray-900 mb-1","children":"Sunday Flea Markets & Pop-ups"}],["$","p",null,{"className":"text-sm text-gray-500 mb-1","children":"Various — Koramangala, Whitefield, Jayanagar"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":"Sunday afternoons are prime flea market time in Bangalore. The Sunday Soul Sante (when it's on), Dyu Art Café market, and smaller pop-ups in Koramangala and HSR are worth checking. Local designers, vintage finds, and street food all in one place. Usually 11 AM–7 PM. Follow Happ'nin for confirmed Sunday market listings this week."}]]}],["$","div",null,{"className":"border-l-2 border-rose-200 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold text-rose-500 uppercase tracking-wide mb-0.5","children":"Night · Music"}],["$","h3",null,{"className":"font-semibold text-gray-900 mb-1","children":"Biggest South Indian DJ Night @Vapour"}],["$","p",null,{"className":"text-sm text-gray-500 mb-1","children":"Vapour, Indiranagar"}],["$","p",null,{"className":"text-sm text-gray-700 leading-relaxed","children":"Sunday night at Vapour with DJ VLSJ & DJ Sandy spinning South Indian blockbusters. Vapour has a big basement floor, decent sound, and pulls a crowd that actually knows the songs. If you're into Tollywood, Kollywood, and Tamil chartbusters — this is the right room. Entry from 9 PM."}]]}]]}]
c:["$","div",null,{"className":"bg-orange-50 rounded-2xl p-5 mb-8","children":[["$","h3",null,{"className":"font-semibold text-gray-900 mb-3","children":"Weekend Logistics"}],["$","ul",null,{"className":"text-sm text-gray-700 space-y-2 leading-relaxed","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Getting around:"}]," Rapido bikes work well for short hops in Indiranagar and Koramangala. Namma Metro covers the CBD corridor — useful for Saturday evening."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Weather:"}]," April in Bangalore means warm days (28–32°C) and cooler evenings. Light clothes during the day; carry a layer for late nights at rooftop spots."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Book ahead:"}]," The Humming Tree and popular Saturday night venues sell out. Book tickets online — walk-ins often get turned away after 9 PM."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Sunday treks:"}]," Pre-book with a group operator for logistics — parking at Nandi Hills on a Sunday is chaos if you drive independently."]}]]}]]}]
