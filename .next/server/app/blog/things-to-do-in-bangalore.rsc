12:{"metadata":[["$","title","0",{"children":"27 Best Things to Do in Bangalore You Actually Can't Miss"}],["$","meta","1",{"name":"description","content":"From rooftop breweries in Indiranagar to hidden lakes in Whitefield, here are the best things to do in Bangalore for locals and first-timers alike."}],["$","meta","2",{"name":"author","content":"Happenings Bangalore Team"}],["$","link","3",{"rel":"manifest","href":"/manifest.json","crossOrigin":"$undefined"}],["$","meta","4",{"name":"keywords","content":"Things to do in Bangalore, Bangalore activities, Bangalore date ideas, couple packages Bangalore, Bangalore weekend plans, curated experiences, what to do in Bangalore today, Bangalore outings"}],["$","meta","5",{"name":"theme-color","content":"#234E52"}],["$","meta","6",{"name":"apple-mobile-web-app-capable","content":"yes"}],["$","meta","7",{"name":"apple-mobile-web-app-status-bar-style","content":"black-translucent"}],["$","meta","8",{"name":"apple-mobile-web-app-title","content":"Happenings"}],["$","meta","9",{"name":"google-site-verification","content":"SoqryeoxVNXgE9ehNMjuOGD3NqQfHYvVUEEovZcLcfY"}],["$","meta","10",{"property":"og:title","content":"Happenings Bangalore | Discover Curated Experiences"}],["$","meta","11",{"property":"og:description","content":"Plan your next day out in Bangalore with handpicked activities, events, and packages. From date ideas to fun with friends – we've got your weekend covered."}],["$","meta","12",{"property":"og:url","content":"https://happeningsbangalore.com"}],["$","meta","13",{"property":"og:site_name","content":"Happenings Bangalore"}],["$","meta","14",{"property":"og:locale","content":"en_IN"}],["$","meta","15",{"property":"og:image","content":"https://happeningsbangalore.com/assets/og-image.jpg"}],["$","meta","16",{"property":"og:type","content":"website"}],["$","meta","17",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","18",{"name":"twitter:title","content":"Happenings Bangalore | Discover Cura