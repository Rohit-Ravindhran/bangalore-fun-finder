7:["$","$L12",null,{"initialActivity":{"id":"77","title":"Pickleball with Strangers","image":"https://media.insider.in/image/upload/c_crop,g_custom/v1766580687/opwlahgu79eceu3nehql.jpg","tags":["5"],"priceRange":"425","location":"Paddle Park,Bengaluru","lastUpdated":"3/19/2026","categoryIds":["4","8"],"categoryNames":[],"description":"A relaxed weekend pickleball session for anyone who wants to move, rally, laugh and meet a few fresh faces.\n\nWhether you’re unwinding from the week or kicking off your Saturday night with a little friendly sport — come join us for a mixed-level pickleball run. Come solo or bring a buddy — we’ll rotate partners so everyone gets a chance to play.\n\nWhat to Expect\n\nCasual pickleball games (no pro coaching)\n\nRotating doubles so everyone plays + meets new partners\n\nEasy vibe — competition optional\n\nOpen to all — beginners welcome, intermediates welcome, everyone fits in\n\n(Covers court booking, paddles (limited), balls & water)\n\nWhat to Bring\n\nComfortable non-marking shoes\n\nYour own paddle (if you have one — we’ll have a few extras)","date":"Mar 22 , 2026","time":"05:00 PM - 06:00 PM","mapLink":"https://www.google.com/maps?q=13.0182963,77.6592165","contactInfo":"","url":"https://www.district.in/events/pickleball-with-strangers-jan3-2026-buy-tickets"}}]
