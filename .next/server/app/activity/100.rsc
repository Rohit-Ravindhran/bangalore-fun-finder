7:["$","$L12",null,{"initialActivity":{"id":"100","title":"Andrea Live Concert At Bangalore","image":"https://assets-in.bmscdn.com/nmcms/events/banner/desktop/media-desktop-andrea-live-concert-at-bangalore-0-2026-2-4-t-8-48-51.jpg","tags":["Event"],"priceRange":"₹699.00","location":"Bangalore","lastUpdated":"4/3/2026","categoryIds":["1","3","6"],"categoryNames":[],"description":"Highlights Live concert by Andrea Jeremiah Powerful vocals and high energy stage presence Blend of soulful melodies and upbeat tracks Engaging performance with sing along favourites Dynamic music experience with nonstop vibes Perfect night for live music lovers Get ready for an unforgettable live music experience as Andrea Jeremiah takes the stage with her signature energy and magnetic presence. Known for her powerful vocals and genre blending sound, the concert promises a seamless mix of soulful moments and foot tapping performances. From emotional melodies to high tempo beats that keep the crowd moving, every segment is designed to keep the energy alive. This is more than just a live performance, it is a night of music, connection, and pure entertainment.","date":"Sun, 5 Apr, 2026","time":"12:00 am","mapLink":"https://www.google.com/maps/search/?api=1&query=13.007736,77.689245","contactInfo":"","url":"https://in.bookmyshow.com/events/andrea-live-concert-at-bangalore/ET00485062"}}]
