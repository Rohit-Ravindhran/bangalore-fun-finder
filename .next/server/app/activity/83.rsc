7:["$","$L12",null,{"initialActivity":{"id":"83","title":"Pottery Hug","image":"https://assets-in.bmscdn.com/nmcms/events/banner/desktop/media-desktop-pottery-hug-0-2025-3-15-t-3-34-18.jpg","tags":["Event"],"priceRange":"₹899.00","location":"Bangalore","lastUpdated":"3/19/2026","categoryIds":["2","6"],"categoryNames":[],"description":"Join us for Pottery Hug, a unique and intimate pottery experience where you don’t just shape the clay—you embrace it! Whether you come solo or with a partner, this hands-on workshop invites you to hug and mold pottery, deepening your connection with the art and each other. This heartwarming experience is designed to strengthen bonds, promote mindfulness, and create something truly special—just like your relationships. Feel the warmth of the clay, the closeness of your embrace, and the joy of shaping art together. Come, hug, mold, and create magic!","date":"Wed, 25 Mar, 2026","time":"07:30 pm","mapLink":"https://www.google.com/maps/search/?api=1&query=12.9341,77.6303","contactInfo":"","url":"https://in.bookmyshow.com/events/pottery-hug/ET00438160"}}]
