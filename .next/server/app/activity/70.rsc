7:["$","$L12",null,{"initialActivity":{"id":"70","title":"Soul Jams | Bengaluru","image":"https://media.insider.in/image/upload/c_crop,g_custom/v1772815644/xtfcnoftht3y9uu3cbq3.png","tags":[],"priceRange":"499","location":"Brigade Road , Bangalore","lastUpdated":"3/19/2026","categoryIds":["2"],"categoryNames":[],"description":"Soul Jams is the ultimate destination for music lovers! Join us for an evening of relaxation, unwinding, and rejuvenation. Our welcoming space allows you to be yourself and feel at home.\n\nBring your guitars, cajones, and voices to sing your heart out alongside our vibrant community in a beautiful jamming session. You can also enjoy listening to amazing artists or take the stage yourself, supported by an accepting and supportive community.\n\nThe event comprises three soul-enriching parts:\n\nSoul Open Mic: Perform for a warm and appreciative audience, regardless of where you are on your musical journey. Alternatively, simply chill and enjoy the incredible performers.\n\nSoul Circle: Connect with like-minded individuals and find your tribe, fostering meaningful connections.\n\nSoul Jamming: Sing, play instruments, and join the community in a spontaneous, free-flowing musical experience. We create music together, fostering an atmosphere of refreshment and excitement.","date":"Mar 14 , 2026","time":"04:30 PM ","mapLink":"https://maps.app.goo.gl/hz2s3Je82mFn7As59","contactInfo":"","url":"https://www.district.in/events/soul-jams-bengaluru-mar14-2026-buy-tickets?fbclid=PAZXh0bgNhZW0CMTEAc3J0YwZhcHBfaWQMMjU2MjgxMDQwNTU4AAGng7QEIkFjyIwfhePHGIaEAp-HXsoZISKVs8k7znHky3u7TBit9O2itzEY4pI_aem_Ny8Vvj-FutcK8UmMaxwTvg&source_caller=api&pid=SocialShare&utm_content=link_in_bio&utm_source=ig&shortlink=0vonj5r1&utm_medium=social&deep_link_value=edition%3A%2F%2Fresolve-onelink%3Flink_type%3Dopen_event_details_page%26link_params%3D%7B%22event_id%22%3A%2269aace4004834cf3422889a7%22%2C%22event_slug%22%3A%22soul-jams-bengaluru-mar14-2026%22%7D%26utm_source%3DSocialShare%26share_tag%3D%2FNGeopDHkMFDHCnnKfbzyOnqCHald51zwDP3OFPkIclrRv%2Fj&link_params=%7B%22event_id%22:%2269aace4004834cf3422889a7%22,%22event_slug%22:%22soul-jams-bengaluru-mar14-2026%22%7D&link_type=open_event_details_page"}}]
b:{"metadata":[["$","title","0",{"children":"Soul Jams | Bengaluru | Happenings Bangalore"}],["$","meta","1",{"name":"description","content":"Soul Jams is the ultimate destination for music lovers! Join us for an evening of relaxation, unwinding, and rejuvenation. Our welcoming space allows you to be yourself and feel at home.\n\nBring your guitars, cajones, and voices to sing your heart out alongside our vibrant community in a beautiful jamming session. You can also enjoy listening to amazing artists or take the stage yourself, supported by an accepting and supportive community.\n\nThe event comprises three soul-enriching parts:\n\nSoul Open Mic: Perform for a warm and appreciative audience, regardless of where you are on your musical journey. Alternatively, simply chill and enjoy the incredible performers.\n\nSoul Circle: Connect with like-minded individuals and find your tribe, fostering meaningful connections.\n\nSoul Jamming: Sing, play instruments, and join the community in a spontaneous, free-flowing musical experience. We create music together, fostering an atmosphere of refreshment and excitement."}],["$","meta","2",{"name":"author","content":"Happenings Bangalore Team"}],["$","link","3",{"rel":"manifest","href":"/manifest.json","crossOrigin":"$undefined"}],["$","meta","4",{"name":"keywords","content":"Soul Jams | Bengaluru, Brigade Road , Bangalore, Bangalore"}],["$","meta","5",{"name":"theme-color","content":"#234E52"}],["$","meta","6",{"name":"apple-mobile-web-app-capable","content":"yes"}],["$","meta","7",{"name":"apple-mobile-web-app-status-bar-style","content":"black-translucent"}],["$","meta","8",{"name":"apple-mobile-web-app-title","content":"Happenings"}],["$","meta","9",{"name":"google-site-verification","content":"SoqryeoxVNXgE9ehNMjuOGD3NqQfHYvVUEEovZcLcfY"}],["$","meta","10",{"property":"og:title","content":"Soul Jams | Bengaluru"}],["$","meta","11",{"property":"og:description","content":"Soul Jams is the ultimate destination for music lovers! Join us for an evening of relaxation, unwinding, and rejuvenation. Our welcoming space allows you to be yourself and feel at home.\n\nBring your guitars, cajones, and voices to sing your heart out alongside our vibrant community in a beautiful jamming session. You can also enjoy listening to amazing artists or take the stage yourself, supported by an accepting and supportive community.\n\nThe event comprises three soul-enriching parts:\n\nSoul Open Mic: Perform for a warm and appreciative audience, regardless of where you are on your musical journey. Alternatively, simply chill and enjoy the incredible performers.\n\nSoul Circle: Connect with like-minded individuals and find your tribe, fostering meaningful connections.\n\nSoul Jamming: Sing, play instruments, and join the community in a spontaneous, free-flowing musical experience. We create music together, fostering an atmosphere of refreshment and excitement."}],["$","meta","12",{"property":"og:url","content":"https://happeningsbangalore.com/activity/70"}],["$","meta","13",{"property":"og:image","content":"https://media.insider.in/image/upload/c_crop,g_custom/v1772815644/xtfcnoftht3y9uu3cbq3.png"}],["$","meta","14",{"property":"og:image:alt","content":"Soul Jams | Bengaluru"}],["$","meta","15",{"property":"og:type","content":"article"}],["$","meta","16",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","17",{"name":"twitter:title","content":"Soul Jams | Bengaluru"}],["$","meta","18",{"name":"twitter:description","content":"Soul Jams is the ultimate destination for music lovers! Join us for an evening of relaxation, unwinding, and rejuvenation. Our welcoming space allows you to be yourself and feel at home.\n\nBring your guitars, cajones, and voices to sing your heart out alongside our vibrant community in a beautiful jamming session. You can also enjoy listening to amazing artists or take the stage yourself, supported by an accepting and supportive community.\n\nThe event comprises three soul-e