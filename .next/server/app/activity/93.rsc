7:["$","$L12",null,{"initialActivity":{"id":"93","title":"Art Meet-Cute","image":"https://d10y46cwh6y6x1.cloudfront.net/images/791CC5EE02B64A6FBC23417DCAA07FD7_converted_webp.webp","tags":["art","meetup","beginner-friendly","creative"],"priceRange":"INR 799","location":"Green Theory, Shanthala Nagar, Richmond Town, Bangalore","lastUpdated":"3/26/2026","categoryIds":["2","3","6"],"categoryNames":[],"description":"Art Meet-Cute is a gentle evening where strangers sit around a table with paper, colours and small prompts, and let conversations grow naturally. Instead of practiced introductions, you’ll make something with your hands. Instead of awkward questions, there’ll be art, shared silences, small jokes, and the comfort of being around kind people. Come alone. Leave with a page, a memory, or a feeling you can’t quite explain yet. No pressure. No labels. Let art do the talking - the rest can happen between the lines. The space will be gently held and facilitated by Your Journal Project (Yukti). You’ll get: all art materials & thoughtful curiosity-led prompts. You’ll take: your artwork, a new third place to quietly call home, and maybe a date... or at the very least, a friend.","date":"Saturday, March 28","time":"Multiple","mapLink":"https://maps.app.goo.gl/9NHPAgXbCLPTtQNF6","contactInfo":"","url":"https://urbanaut.app/spot/art-meet-cute"}}]
