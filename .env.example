# Supabase Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only — used by /api/admin/upload-image to bypass storage RLS.
# Find this in Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI key — consumed by Supabase edge functions (extract-from-instagram,
# generate-carousel-content). Set as a Supabase secret, NOT in this file:
#   supabase secrets set OPENAI_API_KEY=sk-...
# Local crawler scripts also read it from process.env.OPENAI_API_KEY.
OPENAI_API_KEY=your_openai_api_key_here
